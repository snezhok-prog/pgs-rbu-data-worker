* text=auto
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
*.bpmn text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.properties text eol=lf
*.example text eol=lf
# Integration files are covered by exact byte hashes in the guarded manifest.
integration/pet/bpmn/*.bpmn -text whitespace=cr-at-eol
*.pdf binary
*.jpg binary
*.jpeg binary
*.png binary
*.docx binary
*.xlsx binary
*.crt binary
