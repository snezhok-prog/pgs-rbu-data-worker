<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RbuPetRollback" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_RbuConfirmPetRollback" name="Удалить импортированные данные" />
  <bpmn:message id="Message_RbuReviewPetRollback" name="Ознакомиться с результатами удаления данных" />
  <bpmn:process id="Process_RbuPetRollback" isExecutable="true" name="Питомец — Удаление импортированных данных">
    <bpmn:startEvent id="StartEvent_RbuPetRollback" name="Дело зарегистрировано">
      <bpmn:outgoing>Flow_StartToPrepare</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask camunda:asyncBefore="true" id="Activity_RbuPreparePetRollback" name="Подготовить безопасный план удаления" camunda:type="external" camunda:topic="pgs-rbu-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">ROLLBACK_PREPARE</camunda:inputParameter>
          <camunda:inputParameter name="rbuDomain">PET</camunda:inputParameter>
          <camunda:inputParameter name="rbuProfile">ROIV</camunda:inputParameter>
          <camunda:inputParameter name="rbuContractVersion">1</camunda:inputParameter>
          <camunda:inputParameter name="collectionName">rbuModulesAppeals.subservices</camunda:inputParameter>
          <camunda:inputParameter name="mainId">${mainId}</camunda:inputParameter>
          <camunda:inputParameter name="camundaBusinessInfoId">${camundaBusinessInfoId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0mzkfrk</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareToConfirm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_RbuConfirmPetRollback" name="Удалить импортированные данные">
      <bpmn:incoming>Flow_PrepareToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmToDeleteBatch</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_RbuConfirmPetRollback" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask camunda:asyncBefore="true" id="Activity_RbuDeletePetRollbackBatch" name="Удалить пачку записей на сервере" camunda:type="external" camunda:topic="pgs-rbu-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R5/PT5M</camunda:failedJobRetryTimeCycle>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">ROLLBACK_EXECUTE</camunda:inputParameter>
          <camunda:inputParameter name="rbuDomain">PET</camunda:inputParameter>
          <camunda:inputParameter name="rbuProfile">ROIV</camunda:inputParameter>
          <camunda:inputParameter name="rbuContractVersion">1</camunda:inputParameter>
          <camunda:inputParameter name="collectionName">rbuModulesAppeals.subservices</camunda:inputParameter>
          <camunda:inputParameter name="mainId">${mainId}</camunda:inputParameter>
          <camunda:inputParameter name="camundaBusinessInfoId">${camundaBusinessInfoId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ConfirmToDeleteBatch</bpmn:incoming>
      <bpmn:incoming>Flow_PetExternalRollbackMore</bpmn:incoming>
      <bpmn:outgoing>Flow_PetExternalRollbackExecuteToBatch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask camunda:asyncBefore="true" id="Activity_RbuFinalizePetRollback" name="Зафиксировать результат удаления" camunda:type="external" camunda:topic="pgs-rbu-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">ROLLBACK_FINALIZE</camunda:inputParameter>
          <camunda:inputParameter name="rbuDomain">PET</camunda:inputParameter>
          <camunda:inputParameter name="rbuProfile">ROIV</camunda:inputParameter>
          <camunda:inputParameter name="rbuContractVersion">1</camunda:inputParameter>
          <camunda:inputParameter name="collectionName">rbuModulesAppeals.subservices</camunda:inputParameter>
          <camunda:inputParameter name="mainId">${mainId}</camunda:inputParameter>
          <camunda:inputParameter name="camundaBusinessInfoId">${camundaBusinessInfoId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0v18ir6</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalizeToNotifyFork</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_RbuPetRollbackNotifyFork" name="Результат и уведомление">
      <bpmn:incoming>Flow_FinalizeToNotifyFork</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalizeToReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_RbuNotifyPetRollback</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask camunda:asyncBefore="true" camunda:class="io.aimc.bpmn.camunda.UniversalServiceConnector" id="Activity_RbuNotifyPetRollback" name="Уведомить об удалении мигрированных данных">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="target_url">http://camunda-integration:8080/exchange/event</camunda:inputParameter>
          <camunda:inputParameter name="async">false</camunda:inputParameter>
          <camunda:inputParameter name="invocation_properties">
            <camunda:map>
              <camunda:entry key="method">POST</camunda:entry>
              <camunda:entry key="type">generateMessage</camunda:entry>
              <camunda:entry key="receiverType">allUsersInUnit</camunda:entry>
              <camunda:entry key="notificationCode">rbuPetImportRollbackCompleted</camunda:entry>
              <camunda:entry key="routing">/rbuModulesPetCoordination/import-data/common-appeals/edit</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RbuNotifyPetRollback</bpmn:incoming>
      <bpmn:outgoing>Flow_RbuNotifyPetRollbackEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_RbuPetRollbackNotify" name="Уведомление обработано">
      <bpmn:incoming>Flow_RbuNotifyPetRollbackEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_RbuReviewPetRollback" name="Ознакомиться с результатами удаления данных">
      <bpmn:incoming>Flow_FinalizeToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_RbuReviewPetRollback" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_RbuPetRollback" name="Удаление завершено">
      <bpmn:incoming>Flow_PetCompleteStatusToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToPrepare" sourceRef="StartEvent_RbuPetRollback" targetRef="Event_0mvaa6x" />
    <bpmn:sequenceFlow id="Flow_PrepareToConfirm" sourceRef="Activity_RbuPreparePetRollback" targetRef="Event_RbuConfirmPetRollback" />
    <bpmn:sequenceFlow id="Flow_ConfirmToDeleteBatch" sourceRef="Event_RbuConfirmPetRollback" targetRef="Activity_RbuDeletePetRollbackBatch" />
    <bpmn:sequenceFlow id="Flow_FinalizeToNotifyFork" sourceRef="Activity_RbuFinalizePetRollback" targetRef="Gateway_RbuPetRollbackNotifyFork" />
    <bpmn:sequenceFlow id="Flow_FinalizeToReview" sourceRef="Gateway_RbuPetRollbackNotifyFork" targetRef="Event_RbuReviewPetRollback" />
    <bpmn:sequenceFlow id="Flow_RbuNotifyPetRollback" sourceRef="Gateway_RbuPetRollbackNotifyFork" targetRef="Activity_RbuNotifyPetRollback" />
    <bpmn:sequenceFlow id="Flow_RbuNotifyPetRollbackEnd" sourceRef="Activity_RbuNotifyPetRollback" targetRef="EndEvent_RbuPetRollbackNotify" />
    <bpmn:sequenceFlow id="Flow_ReviewToEnd" sourceRef="Event_RbuReviewPetRollback" targetRef="Activity_RbuCompletePetRollbackStatus" />
    <bpmn:serviceTask camunda:topic="business-external-tasks-executor-status" camunda:type="external" id="Activity_RbuCompletePetRollbackStatus" name="Установить статус «Завершено»">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="type">executeAction</camunda:inputParameter>
          <camunda:inputParameter name="nextStatusCode">complete</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewToEnd</bpmn:incoming>
      <bpmn:outgoing>Flow_PetCompleteStatusToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PetCompleteStatusToEnd" sourceRef="Activity_RbuCompletePetRollbackStatus" targetRef="EndEvent_RbuPetRollback" />
    <bpmn:scriptTask camunda:asyncBefore="true" id="Activity_RbuReadAppealNumber" name="Проверить номер заявления" scriptFormat="groovy">
      <bpmn:incoming>Flow_08258i5</bpmn:incoming>
      <bpmn:outgoing>Flow_RbuNumberRead</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import ru.evolenta.sier.Core

String collection = execution.getVariable('collectionName')?.toString()?.split(/\.subservices/)[0]
String id = execution.getVariable('mainId')?.toString()?.trim()
if (!collection || !id) throw new IllegalStateException('Невозможно проверить номер: не определено дело')

def slurper = new JsonSlurper()

def appealSearchQuery = [
    search: [
        search: [
            [field: '_id', operator: 'eq', value: id]
        ]
    ],
    page: 0,
    size: 1,
    needCount: false,
    prj: 'rbuAppealNumberOnly'
]

String responseJson = Core.search(
    collection,
    JsonOutput.toJson(appealSearchQuery),
    execution
)

def result = slurper.parseText(responseJson)

if (!(result instanceof Map)) {
    throw new IllegalStateException(
        'Не удалось проверить номер: некорректный ответ поиска'
    )
}

if (result.error || result.errors || result.success == false) {
    throw new IllegalStateException(
        'Не удалось проверить номер: сервис поиска вернул ошибку'
    )
}

if (!(result.content instanceof List)) {
    throw new IllegalStateException(
        'Не удалось проверить номер: в ответе отсутствует список content'
    )
}

List records = result.content as List

if (records.isEmpty()) {
    throw new IllegalStateException(
        'Не удалось проверить номер: дело не найдено'
    )
}

def appeal = records[0]

if (!(appeal instanceof Map) || appeal._id?.toString() != id) {
    throw new IllegalStateException(
        'Не удалось проверить номер: найденная запись не соответствует делу'
    )
}


if (appeal.number != null &amp;&amp; !(appeal.number instanceof CharSequence)) {
    throw new IllegalStateException('Номер дела имеет некорректный тип')
}
String number = appeal.number?.toString()?.trim() ?: ''
def rawUnitId = appeal.unitId
if (rawUnitId == null || (rawUnitId instanceof CharSequence &amp;&amp; !rawUnitId.toString().trim())) {
    rawUnitId = appeal.unit instanceof Map ? appeal.unit.id : null
}
if (!number &amp;&amp; rawUnitId != null &amp;&amp; !(rawUnitId instanceof CharSequence)) {
    throw new IllegalStateException('Невозможно присвоить номер: некорректный идентификатор организации')
}
String unitId = rawUnitId instanceof CharSequence ? rawUnitId.toString().trim() : ''
if (!number &amp;&amp; !unitId) throw new IllegalStateException('Невозможно присвоить номер: не определена организация дела')
execution.setVariable('rbuAppealNumberPresent', !number.isEmpty())
execution.setVariable('rbuAppealNumber', number)
execution.setVariable('rbuAppealNumberTag', unitId ?: '')</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway default="Flow_RbuNumberMissing" id="Gateway_RbuHasAppealNumber" name="Номер присвоен?">
      <bpmn:incoming>Flow_RbuNumberRead</bpmn:incoming>
      <bpmn:outgoing>Flow_RbuNumberPresent</bpmn:outgoing>
      <bpmn:outgoing>Flow_RbuNumberMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask camunda:topic="business-external-tasks-executor-number" camunda:type="external" id="Activity_RbuAssignAppealNumber" name="Присвоить номер заявления">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="type">assignEntryNumber</camunda:inputParameter>
          <camunda:inputParameter name="algorithm">NNNNNNNN</camunda:inputParameter>
          <camunda:inputParameter name="tag">${rbuAppealNumberTag}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RbuNumberMissing</bpmn:incoming>
      <bpmn:outgoing>Flow_RbuNumberAssigned</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RbuNumberRead" sourceRef="Activity_RbuReadAppealNumber" targetRef="Gateway_RbuHasAppealNumber" />
    <bpmn:sequenceFlow id="Flow_RbuNumberPresent" sourceRef="Gateway_RbuHasAppealNumber" targetRef="Gateway_1e4860i">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('rbuAppealNumberPresent') == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RbuNumberMissing" sourceRef="Gateway_RbuHasAppealNumber" targetRef="Activity_RbuAssignAppealNumber" />
    <bpmn:sequenceFlow id="Flow_RbuNumberAssigned" sourceRef="Activity_RbuAssignAppealNumber" targetRef="Gateway_1e4860i" />
    <bpmn:intermediateCatchEvent id="Event_0mvaa6x">
      <bpmn:incoming>Flow_StartToPrepare</bpmn:incoming>
      <bpmn:outgoing>Flow_08258i5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0v4d9kr">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_08258i5" sourceRef="Event_0mvaa6x" targetRef="Activity_RbuReadAppealNumber" />
    <bpmn:exclusiveGateway id="Gateway_1e4860i" name="Номер присвоен?">
      <bpmn:incoming>Flow_RbuNumberPresent</bpmn:incoming>
      <bpmn:incoming>Flow_RbuNumberAssigned</bpmn:incoming>
      <bpmn:outgoing>Flow_0mzkfrk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0mzkfrk" sourceRef="Gateway_1e4860i" targetRef="Activity_RbuPreparePetRollback" />
    <bpmn:sequenceFlow id="Flow_0v18ir6" sourceRef="Gateway_PetExternalRollbackBatch" targetRef="Activity_RbuFinalizePetRollback" />
    <bpmn:exclusiveGateway id="Gateway_PetExternalRollbackBatch" name="Есть следующий пакет серверного отката?" default="Flow_0v18ir6">
      <bpmn:incoming>Flow_PetExternalRollbackExecuteToBatch</bpmn:incoming>
      <bpmn:outgoing>Flow_0v18ir6</bpmn:outgoing>
      <bpmn:outgoing>Flow_PetExternalRollbackMore</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_PetExternalRollbackExecuteToBatch" sourceRef="Activity_RbuDeletePetRollbackBatch" targetRef="Gateway_PetExternalRollbackBatch" />
    <bpmn:sequenceFlow id="Flow_PetExternalRollbackMore" sourceRef="Gateway_PetExternalRollbackBatch" targetRef="Activity_RbuDeletePetRollbackBatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rbuRollbackHasMore == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
