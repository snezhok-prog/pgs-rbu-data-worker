      <bpmn:serviceTask camunda:asyncAfter="true" camunda:asyncBefore="true" id="Activity_PetProcessOneRow" name="Применить очередной пакет импорта" camunda:type="external" camunda:topic="pgs-data-processing-v1">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="rbuOperation">IMPORT_APPLY</camunda:inputParameter>
