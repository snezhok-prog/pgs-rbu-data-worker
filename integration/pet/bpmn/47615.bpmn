    <bpmn:scriptTask camunda:asyncBefore="true" id="Activity_PetFinishBatch" name="Проверить результат серверного пакета" scriptFormat="groovy">
      <bpmn:incoming>Flow_PetRows_ToFinish</bpmn:incoming>
      <bpmn:outgoing>Flow_0ji4s2g</bpmn:outgoing>
      <bpmn:script>def more = execution.getVariable('rbuApplyHasMoreBatches')
def status = execution.getVariable('rbuApplicationStatus')
if (!(more instanceof Boolean) || (more &amp;&amp; status != 'APPLYING') || (!more &amp;&amp; status != 'APPLIED')) {
    throw new IllegalStateException('Результат серверного пакета импорта не подтверждён.')
}
return null
</bpmn:script>
    </bpmn:scriptTask>
