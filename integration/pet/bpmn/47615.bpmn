<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="Camunda Modeler" exporterVersion="5.38.0" id="Definitions_RbuPetImport" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_RbuPetImportCopy" isExecutable="true" name="РБУ — Импорт исторических данных «Мой питомец»">
    <bpmn:startEvent id="StartEvent_RbuImport" name="Задание зарегистрировано">
      <bpmn:outgoing>Flow_StartToValidate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask camunda:asyncBefore="true" id="Activity_RbuValidateImport" name="Проверить файл и дубли" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">PARSE_VALIDATE</camunda:inputParameter>
          <camunda:inputParameter name="rbuDomain">PET</camunda:inputParameter>
          <camunda:inputParameter name="rbuProfile">ROIV</camunda:inputParameter>
          <camunda:inputParameter name="rbuContractVersion">1</camunda:inputParameter>
          <camunda:inputParameter name="collectionName">rbuModulesAppeals.subservices</camunda:inputParameter>
          <camunda:inputParameter name="mainId">${mainId}</camunda:inputParameter>
          <camunda:inputParameter name="camundaBusinessInfoId">${camundaBusinessInfoId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Event_RbuReloadInvalidToTask</bpmn:incoming>
      <bpmn:incoming>Flow_0rq3jrz</bpmn:incoming>
      <bpmn:incoming>Flow_0v1p81p</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateToDecision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask camunda:asyncBefore="true" id="Activity_RbuApplyImport" name="Проверить готовность очередного пакета" scriptFormat="groovy">
      <bpmn:incoming>Flow_RetryToApply</bpmn:incoming>
      <bpmn:incoming>Flow_1mg5d1c</bpmn:incoming>
      <bpmn:incoming>Flow_ApplyBatchLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_0n7n70e</bpmn:outgoing>
      <bpmn:script>def status = execution.getVariable('rbuApplicationStatus')
if (execution.getVariable('rbuCanApply') != true &amp;&amp; !(status in ['APPLYING', 'APPLIED'])) {
    throw new IllegalStateException('Нет подтверждённой серверной проверки для продолжения импорта.')
}
return null
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask camunda:asyncBefore="true" id="Activity_RbuPersistPetJournal" name="Сверить реестры и подтвердить импорт" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">IMPORT_FINALIZE</camunda:inputParameter>
          <camunda:inputParameter name="rbuDomain">PET</camunda:inputParameter>
          <camunda:inputParameter name="rbuProfile">ROIV</camunda:inputParameter>
          <camunda:inputParameter name="rbuContractVersion">1</camunda:inputParameter>
          <camunda:inputParameter name="collectionName">rbuModulesAppeals.subservices</camunda:inputParameter>
          <camunda:inputParameter name="mainId">${mainId}</camunda:inputParameter>
          <camunda:inputParameter name="camundaBusinessInfoId">${camundaBusinessInfoId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApplyAccepted</bpmn:incoming>
      <bpmn:outgoing>Flow_PersistToCompleteStatus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway default="Flow_NoMigrationNotification" id="Gateway_RbuMigrationNotifyDecision" name="Миграция выполнена?">
      <bpmn:incoming>Flow_1xojzja</bpmn:incoming>
      <bpmn:incoming>Flow_PersistToCompleteStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyMigrationIfApplied</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoMigrationNotification</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask camunda:asyncBefore="true" camunda:class="io.aimc.bpmn.camunda.UniversalServiceConnector" id="Activity_RbuNotifyPetMigration" name="Уведомить о завершении миграции">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="target_url">http://camunda-integration:8080/exchange/event</camunda:inputParameter>
          <camunda:inputParameter name="async">false</camunda:inputParameter>
          <camunda:inputParameter name="invocation_properties">
            <camunda:map>
              <camunda:entry key="method">POST</camunda:entry>
              <camunda:entry key="type">generateMessage</camunda:entry>
              <camunda:entry key="receiverType">allUsersInUnit</camunda:entry>
              <camunda:entry key="notificationCode">rbuPetImportMigrationCompleted</camunda:entry>
              <camunda:entry key="routing">/rbuModulesPetCoordination/import-data/common-appeals/edit</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotifyMigrationIfApplied</bpmn:incoming>
      <bpmn:outgoing>Flow_1donabj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_StartToValidate" sourceRef="StartEvent_RbuImport" targetRef="Event_13948l4" />
    <bpmn:sequenceFlow id="Flow_ValidateToDecision" sourceRef="Activity_RbuValidateImport" targetRef="Gateway_RbuValidationNotifyFork" />
    <bpmn:sequenceFlow id="Flow_ValidationNotifyReview" sourceRef="Gateway_RbuValidationNotifyFork" targetRef="Event_RbuReviewValidation" />
    <bpmn:sequenceFlow id="Flow_ValidationNotifyTask" sourceRef="Gateway_RbuValidationNotifyFork" targetRef="Activity_RbuNotifyPetValidation" />
    <bpmn:eventBasedGateway id="Gateway_RbuDecision" name="Решение по миграции">
      <bpmn:incoming>Flow_HasValidDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionToApply</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionToCancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_0304ezj</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_DecisionToApply" sourceRef="Gateway_RbuDecision" targetRef="Event_1brxtpp" />
    <bpmn:sequenceFlow id="Flow_DecisionToCancel" sourceRef="Gateway_RbuDecision" targetRef="Event_1eseu89" />
    <bpmn:sequenceFlow id="Flow_NotifyMigrationIfApplied" sourceRef="Gateway_RbuMigrationNotifyDecision" targetRef="Activity_RbuNotifyPetMigration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rbuApplicationStatus == 'APPLIED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoMigrationNotification" sourceRef="Gateway_RbuMigrationNotifyDecision" targetRef="Gateway_04sokt0" />
    <bpmn:intermediateCatchEvent id="Event_074gtcz" name="Выполнить валидацию">
      <bpmn:incoming>Flow_15h19eg</bpmn:incoming>
      <bpmn:incoming>Flow_1xi0voe</bpmn:incoming>
      <bpmn:outgoing>Flow_0rq3jrz</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1d8ez8g" messageRef="Message_12e60kb" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_1brxtpp" name="Мигрировать данные">
      <bpmn:incoming>Flow_DecisionToApply</bpmn:incoming>
      <bpmn:outgoing>Flow_1mg5d1c</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0fps0na" messageRef="Message_2gvm2ab" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1mg5d1c" sourceRef="Event_1brxtpp" targetRef="Activity_RbuApplyImport" />
    <bpmn:intermediateCatchEvent id="Event_1eseu89" name="Завершить без миграции">
      <bpmn:incoming>Flow_DecisionToCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_NoToCancel</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1c4gkdl" messageRef="Message_12g3rfu" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_NoToCancel" sourceRef="Event_1eseu89" targetRef="Activity_RbuCancelImport" />
    <bpmn:intermediateCatchEvent id="Event_RbuReloadFile" name="Загрузить другой файл">
      <bpmn:incoming>Flow_0304ezj</bpmn:incoming>
      <bpmn:outgoing>Flow_0v1p81p</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RbuReloadFile" messageRef="Message_RbuReloadFile" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_RbuCancelImport" name="Зафиксировать отмену" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">IMPORT_CANCEL</camunda:inputParameter>
          <camunda:inputParameter name="rbuDomain">PET</camunda:inputParameter>
          <camunda:inputParameter name="rbuProfile">ROIV</camunda:inputParameter>
          <camunda:inputParameter name="rbuContractVersion">1</camunda:inputParameter>
          <camunda:inputParameter name="collectionName">rbuModulesAppeals.subservices</camunda:inputParameter>
          <camunda:inputParameter name="mainId">${mainId}</camunda:inputParameter>
          <camunda:inputParameter name="camundaBusinessInfoId">${camundaBusinessInfoId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoToCancel</bpmn:incoming>
      <bpmn:incoming>Flow_Event_RbuCancelInvalidToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_0w1nkap</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_RbuValidationNotifyFork" name="Результат проверки и уведомление">
      <bpmn:incoming>Flow_ValidateToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidationNotifyReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidationNotifyTask</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask camunda:asyncBefore="true" camunda:class="io.aimc.bpmn.camunda.UniversalServiceConnector" id="Activity_RbuNotifyPetValidation" name="Уведомить о завершении проверки файла">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="target_url">http://camunda-integration:8080/exchange/event</camunda:inputParameter>
          <camunda:inputParameter name="async">false</camunda:inputParameter>
          <camunda:inputParameter name="invocation_properties">
            <camunda:map>
              <camunda:entry key="method">POST</camunda:entry>
              <camunda:entry key="type">generateMessage</camunda:entry>
              <camunda:entry key="receiverType">allUsersInUnit</camunda:entry>
              <camunda:entry key="notificationCode">rbuPetImportValidationCompleted</camunda:entry>
              <camunda:entry key="routing">/rbuModulesPetCoordination/import-data/common-appeals/edit</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidationNotifyTask</bpmn:incoming>
      <bpmn:outgoing>Flow_1joxr92</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_RbuPetValidationNotify" name="Уведомление о проверке обработано">
      <bpmn:incoming>Flow_1joxr92</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_RbuReviewValidation" name="Ознакомиться с результатами валидации">
      <bpmn:incoming>Flow_ValidationNotifyReview</bpmn:incoming>
      <bpmn:outgoing>Flow_0v7yx0g</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RbuReviewValidation" messageRef="Message_RbuReviewValidation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway default="Flow_NoValidDecision" id="Gateway_RbuCanApply" name="Есть допустимые строки?">
      <bpmn:incoming>Flow_0v7yx0g</bpmn:incoming>
      <bpmn:outgoing>Flow_HasValidDecision</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoValidDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_RbuNoValidDecision" name="Исправить файл или отменить">
      <bpmn:incoming>Flow_NoValidDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_1hn8jxg</bpmn:outgoing>
      <bpmn:outgoing>Flow_0uxngmf</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_HasValidDecision" sourceRef="Gateway_RbuCanApply" targetRef="Gateway_RbuDecision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rbuCanApply == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoValidDecision" sourceRef="Gateway_RbuCanApply" targetRef="Gateway_RbuNoValidDecision" />
    <bpmn:intermediateCatchEvent id="Event_RbuCancelInvalid" name="Завершить без миграции">
      <bpmn:incoming>Flow_0uxngmf</bpmn:incoming>
      <bpmn:outgoing>Flow_Event_RbuCancelInvalidToTask</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1c4gkdl_Event_RbuCancelInvalid" messageRef="Message_12g3rfu" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_RbuReloadInvalid" name="Загрузить другой файл">
      <bpmn:incoming>Flow_1hn8jxg</bpmn:incoming>
      <bpmn:outgoing>Flow_Event_RbuReloadInvalidToTask</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RbuReloadFile_Event_RbuReloadInvalid" messageRef="Message_RbuReloadFile" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_Event_RbuReloadInvalidToTask" sourceRef="Event_RbuReloadInvalid" targetRef="Activity_RbuValidateImport" />
    <bpmn:exclusiveGateway default="Flow_ApplyBatchDone" id="Gateway_RbuApplyBatch" name="Продолжить пакетное применение?">
      <bpmn:incoming>Flow_0ji4s2g</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyBatchLoop</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApplyBatchDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ApplyBatchLoop" sourceRef="Gateway_RbuApplyBatch" targetRef="Activity_RbuApplyImport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rbuApplyHasMoreBatches == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApplyBatchDone" sourceRef="Gateway_RbuApplyBatch" targetRef="Gateway_RbuApplyOutcome" />
    <bpmn:exclusiveGateway default="Flow_ApplyAccepted" id="Gateway_RbuApplyOutcome" name="Решение принято?">
      <bpmn:incoming>Flow_ApplyBatchDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyAccepted</bpmn:outgoing>
      <bpmn:outgoing>Flow_039e2fp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ApplyAccepted" sourceRef="Gateway_RbuApplyOutcome" targetRef="Activity_RbuPersistPetJournal" />
    <bpmn:intermediateCatchEvent id="Event_RbuRetryImport" name="Повторить миграцию">
      <bpmn:incoming>Flow_039e2fp</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryToApply</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RbuRetryImport" messageRef="Message_16qbbmr" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_RetryToApply" sourceRef="Event_RbuRetryImport" targetRef="Activity_RbuApplyImport" />
    <bpmn:scriptTask camunda:asyncBefore="true" id="Activity_RbuReadAppealNumber" name="Проверить номер заявления" scriptFormat="groovy">
      <bpmn:incoming>Flow_1ydz7p1</bpmn:incoming>
      <bpmn:outgoing>Flow_RbuNumberRead</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import ru.evolenta.sier.Core

String collection = execution.getVariable('collectionName')?.toString()?.split(/\.subservices/)[0]
String id = execution.getVariable('mainId')?.toString()?.trim()
if (!collection || !id) throw new IllegalStateException('Невозможно проверить номер: не определено дело')

def slurper = new JsonSlurper()

def appealSearchQuery = [
    search: [
        search: [
            [field: '_id', operator: 'eq', value: id]
        ]
    ],
    page: 0,
    size: 1,
    needCount: false,
    prj: 'rbuAppealNumberOnly'
]

String responseJson = Core.search(
    collection,
    JsonOutput.toJson(appealSearchQuery),
    execution
)

def result = slurper.parseText(responseJson)

if (!(result instanceof Map)) {
    throw new IllegalStateException(
        'Не удалось проверить номер: некорректный ответ поиска'
    )
}

if (result.error || result.errors || result.success == false) {
    throw new IllegalStateException(
        'Не удалось проверить номер: сервис поиска вернул ошибку'
    )
}

if (!(result.content instanceof List)) {
    throw new IllegalStateException(
        'Не удалось проверить номер: в ответе отсутствует список content'
    )
}

List records = result.content as List

if (records.isEmpty()) {
    throw new IllegalStateException(
        'Не удалось проверить номер: дело не найдено'
    )
}

def appeal = records[0]

if (!(appeal instanceof Map) || appeal._id?.toString() != id) {
    throw new IllegalStateException(
        'Не удалось проверить номер: найденная запись не соответствует делу'
    )
}


if (appeal.number != null &amp;&amp; !(appeal.number instanceof CharSequence)) {
    throw new IllegalStateException('Номер дела имеет некорректный тип')
}
String number = appeal.number?.toString()?.trim() ?: ''
def rawUnitId = appeal.unitId
if (rawUnitId == null || (rawUnitId instanceof CharSequence &amp;&amp; !rawUnitId.toString().trim())) {
    rawUnitId = appeal.unit instanceof Map ? appeal.unit.id : null
}
if (!number &amp;&amp; rawUnitId != null &amp;&amp; !(rawUnitId instanceof CharSequence)) {
    throw new IllegalStateException('Невозможно присвоить номер: некорректный идентификатор организации')
}
String unitId = rawUnitId instanceof CharSequence ? rawUnitId.toString().trim() : ''
if (!number &amp;&amp; !unitId) throw new IllegalStateException('Невозможно присвоить номер: не определена организация дела')
execution.setVariable('rbuAppealNumberPresent', !number.isEmpty())
execution.setVariable('rbuAppealNumber', number)
execution.setVariable('rbuAppealNumberTag', unitId ?: '')</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway default="Flow_RbuNumberMissing" id="Gateway_RbuHasAppealNumber" name="Номер присвоен?">
      <bpmn:incoming>Flow_RbuNumberRead</bpmn:incoming>
      <bpmn:outgoing>Flow_RbuNumberMissing</bpmn:outgoing>
      <bpmn:outgoing>Flow_15h19eg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask camunda:topic="business-external-tasks-executor-number" camunda:type="external" id="Activity_RbuAssignAppealNumber" name="Присвоить номер заявления">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="type">assignEntryNumber</camunda:inputParameter>
          <camunda:inputParameter name="algorithm">NNNNNNNN</camunda:inputParameter>
          <camunda:inputParameter name="tag">${rbuAppealNumberTag}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RbuNumberMissing</bpmn:incoming>
      <bpmn:outgoing>Flow_1xi0voe</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RbuNumberRead" sourceRef="Activity_RbuReadAppealNumber" targetRef="Gateway_RbuHasAppealNumber" />
    <bpmn:sequenceFlow id="Flow_RbuNumberMissing" sourceRef="Gateway_RbuHasAppealNumber" targetRef="Activity_RbuAssignAppealNumber" />
    <bpmn:sequenceFlow id="Flow_15h19eg" sourceRef="Gateway_RbuHasAppealNumber" targetRef="Event_074gtcz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('rbuAppealNumberPresent') == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1xi0voe" sourceRef="Activity_RbuAssignAppealNumber" targetRef="Event_074gtcz" />
    <bpmn:sequenceFlow id="Flow_1ydz7p1" sourceRef="Event_13948l4" targetRef="Activity_RbuReadAppealNumber" />
    <bpmn:intermediateCatchEvent id="Event_13948l4">
      <bpmn:incoming>Flow_StartToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_1ydz7p1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1qtwasr">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_RbuPetMigrationNotify" name="Уведомление о миграции обработано">
      <bpmn:incoming>Flow_15szcc6</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_0d2r6x8" />
    </bpmn:endEvent>
    <bpmn:serviceTask camunda:topic="business-external-tasks-executor-status" camunda:type="external" id="Activity_07gb0d3" name="Установить статус «Завершено»">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="type">executeAction</camunda:inputParameter>
          <camunda:inputParameter name="nextStatusCode">complete</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1i33eqz</bpmn:incoming>
      <bpmn:outgoing>Flow_15szcc6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_04sokt0">
      <bpmn:incoming>Flow_NoMigrationNotification</bpmn:incoming>
      <bpmn:incoming>Flow_1donabj</bpmn:incoming>
      <bpmn:outgoing>Flow_1i33eqz</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1i33eqz" sourceRef="Gateway_04sokt0" targetRef="Activity_07gb0d3" />
    <bpmn:sequenceFlow id="Flow_1donabj" sourceRef="Activity_RbuNotifyPetMigration" targetRef="Gateway_04sokt0" />
    <bpmn:sequenceFlow id="Flow_15szcc6" sourceRef="Activity_07gb0d3" targetRef="EndEvent_RbuPetMigrationNotify" />
    <bpmn:sequenceFlow id="Flow_PersistToCompleteStatus" sourceRef="Activity_RbuPersistPetJournal" targetRef="Gateway_RbuMigrationNotifyDecision" />
    <bpmn:sequenceFlow id="Flow_0w1nkap" sourceRef="Activity_RbuCancelImport" targetRef="Gateway_0at61j8" />
