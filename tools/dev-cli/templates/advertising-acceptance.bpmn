    <bpmn:sequenceFlow id="PgsAdvertisingRollbackV1_flow_Confirm" sourceRef="PgsAdvertisingRollbackV1_Confirm" targetRef="PgsAdvertisingRollbackV1_Execute" />
    <bpmn:sequenceFlow id="PgsAdvertisingRollbackV1_flow_Execute" sourceRef="PgsAdvertisingRollbackV1_Execute" targetRef="PgsAdvertisingRollbackV1_Finalize" />
    <bpmn:sequenceFlow id="PgsAdvertisingRollbackV1_flow_Finalize" sourceRef="PgsAdvertisingRollbackV1_Finalize" targetRef="PgsAdvertisingRollbackV1_End" />
  </bpmn:process>
