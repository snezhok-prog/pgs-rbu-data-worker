          <camunda:inputParameter name="rbuOperation">ROLLBACK_FINALIZE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PgsAdvertisingRollbackV1_End" name="Завершён процесс проверки" />
    <bpmn:sequenceFlow id="PgsAdvertisingRollbackV1_flow_Start" sourceRef="PgsAdvertisingRollbackV1_Start" targetRef="PgsAdvertisingRollbackV1_Setup" />
    <bpmn:sequenceFlow id="PgsAdvertisingRollbackV1_flow_Setup" sourceRef="PgsAdvertisingRollbackV1_Setup" targetRef="PgsAdvertisingRollbackV1_Prepare" />
