<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="ru.polylog.rbu.acceptance">
  <bpmn:process id="PgsAdvertisingImportV1" name="Реклама — Import — проверка DEV" isExecutable="true" camunda:historyTimeToLive="7">
    <bpmn:startEvent id="PgsAdvertisingImportV1_Start" name="Начало" />
    <bpmn:userTask id="PgsAdvertisingImportV1_Setup" name="Подготовить тестовое дело" />
    <bpmn:serviceTask id="PgsAdvertisingImportV1_Parse" name="PARSE_VALIDATE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">PARSE_VALIDATE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="PgsAdvertisingImportV1_Confirm" name="Проверить файл и подтвердить" />
    <bpmn:serviceTask id="PgsAdvertisingImportV1_Apply" name="IMPORT_APPLY" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">IMPORT_APPLY</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="PgsAdvertisingImportV1_Inspect" name="Проверить пакет записей" />
    <bpmn:exclusiveGateway id="PgsAdvertisingImportV1_Decision" name="Продолжить?" default="PgsAdvertisingImportV1_finish" />
    <bpmn:serviceTask id="PgsAdvertisingImportV1_Finalize" name="IMPORT_FINALIZE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">IMPORT_FINALIZE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PgsAdvertisingImportV1_End" name="Завершён процесс проверки" />
    <bpmn:sequenceFlow id="PgsAdvertisingImportV1_flow_Start" sourceRef="PgsAdvertisingImportV1_Start" targetRef="PgsAdvertisingImportV1_Setup" />
    <bpmn:sequenceFlow id="PgsAdvertisingImportV1_flow_Setup" sourceRef="PgsAdvertisingImportV1_Setup" targetRef="PgsAdvertisingImportV1_Parse" />
    <bpmn:sequenceFlow id="PgsAdvertisingImportV1_flow_Parse" sourceRef="PgsAdvertisingImportV1_Parse" targetRef="PgsAdvertisingImportV1_Confirm" />
    <bpmn:sequenceFlow id="PgsAdvertisingImportV1_flow_Confirm" sourceRef="PgsAdvertisingImportV1_Confirm" targetRef="PgsAdvertisingImportV1_Apply" />
    <bpmn:sequenceFlow id="PgsAdvertisingImportV1_flow_Apply" sourceRef="PgsAdvertisingImportV1_Apply" targetRef="PgsAdvertisingImportV1_Inspect" />
    <bpmn:sequenceFlow id="PgsAdvertisingImportV1_flow_Inspect" sourceRef="PgsAdvertisingImportV1_Inspect" targetRef="PgsAdvertisingImportV1_Decision" />
    <bpmn:sequenceFlow id="PgsAdvertisingImportV1_finish" sourceRef="PgsAdvertisingImportV1_Decision" targetRef="PgsAdvertisingImportV1_Finalize" />
    <bpmn:sequenceFlow id="PgsAdvertisingImportV1_flow_Finalize" sourceRef="PgsAdvertisingImportV1_Finalize" targetRef="PgsAdvertisingImportV1_End" />
    <bpmn:sequenceFlow id="PgsAdvertisingImportV1_repeat" sourceRef="PgsAdvertisingImportV1_Decision" targetRef="PgsAdvertisingImportV1_Apply">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rbuApplyHasMoreBatches || rbuRepeat}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="PgsAdvertisingValidationV1" name="Реклама — Validation — проверка DEV" isExecutable="true" camunda:historyTimeToLive="7">
