<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="ru.evolenta.pgs.trade.acceptance">
  <bpmn:process id="PgsPetImportV1" name="Мой питомец — Импорт — DEV" isExecutable="true" camunda:historyTimeToLive="7">
    <bpmn:startEvent id="PgsPetImportV1_Start" name="Начало" />
    <bpmn:userTask id="PgsPetImportV1_Setup" name="Подготовить собственное дело и файл" />
    <bpmn:serviceTask id="PgsPetImportV1_Parse" name="PARSE_VALIDATE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">PARSE_VALIDATE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="PgsPetImportV1_Confirm" name="Проверить результат и подтвердить отпечаток файла" />
    <bpmn:serviceTask id="PgsPetImportV1_Apply" name="IMPORT_APPLY" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">IMPORT_APPLY</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="PgsPetImportV1_Inspect" name="Сверить пакет записей в реестрах" />
    <bpmn:exclusiveGateway id="PgsPetImportV1_Decision" name="Есть следующий пакет или повтор?" default="PgsPetImportV1_finish" />
    <bpmn:serviceTask id="PgsPetImportV1_Finalize" name="IMPORT_FINALIZE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">IMPORT_FINALIZE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PgsPetImportV1_End" name="Процесс проверки завершён" />
    <bpmn:sequenceFlow id="PgsPetImportV1_flow_Start" sourceRef="PgsPetImportV1_Start" targetRef="PgsPetImportV1_Setup" />
    <bpmn:sequenceFlow id="PgsPetImportV1_flow_Setup" sourceRef="PgsPetImportV1_Setup" targetRef="PgsPetImportV1_Parse" />
    <bpmn:sequenceFlow id="PgsPetImportV1_flow_Parse" sourceRef="PgsPetImportV1_Parse" targetRef="PgsPetImportV1_Confirm" />
    <bpmn:sequenceFlow id="PgsPetImportV1_flow_Confirm" sourceRef="PgsPetImportV1_Confirm" targetRef="PgsPetImportV1_Apply" />
    <bpmn:sequenceFlow id="PgsPetImportV1_flow_Apply" sourceRef="PgsPetImportV1_Apply" targetRef="PgsPetImportV1_Inspect" />
    <bpmn:sequenceFlow id="PgsPetImportV1_flow_Inspect" sourceRef="PgsPetImportV1_Inspect" targetRef="PgsPetImportV1_Decision" />
    <bpmn:sequenceFlow id="PgsPetImportV1_finish" sourceRef="PgsPetImportV1_Decision" targetRef="PgsPetImportV1_Finalize" />
    <bpmn:sequenceFlow id="PgsPetImportV1_flow_Finalize" sourceRef="PgsPetImportV1_Finalize" targetRef="PgsPetImportV1_End" />
    <bpmn:sequenceFlow id="PgsPetImportV1_repeat" sourceRef="PgsPetImportV1_Decision" targetRef="PgsPetImportV1_Apply">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rbuApplyHasMoreBatches || rbuRepeat}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="PgsPetValidationV1" name="Мой питомец — Валидация — DEV" isExecutable="true" camunda:historyTimeToLive="7">
    <bpmn:startEvent id="PgsPetValidationV1_Start" name="Начало" />
    <bpmn:userTask id="PgsPetValidationV1_Setup" name="Подготовить собственное дело и файл" />
    <bpmn:serviceTask id="PgsPetValidationV1_Parse" name="PARSE_VALIDATE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">PARSE_VALIDATE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PgsPetValidationV1_End" name="Процесс проверки завершён" />
    <bpmn:sequenceFlow id="PgsPetValidationV1_flow_Start" sourceRef="PgsPetValidationV1_Start" targetRef="PgsPetValidationV1_Setup" />
    <bpmn:sequenceFlow id="PgsPetValidationV1_flow_Setup" sourceRef="PgsPetValidationV1_Setup" targetRef="PgsPetValidationV1_Parse" />
    <bpmn:sequenceFlow id="PgsPetValidationV1_flow_Parse" sourceRef="PgsPetValidationV1_Parse" targetRef="PgsPetValidationV1_End" />
  </bpmn:process>
  <bpmn:process id="PgsPetRollbackV1" name="Мой питомец — Откат — DEV" isExecutable="true" camunda:historyTimeToLive="7">
    <bpmn:startEvent id="PgsPetRollbackV1_Start" name="Начало" />
    <bpmn:userTask id="PgsPetRollbackV1_Setup" name="Подготовить собственное дело и файл" />
    <bpmn:serviceTask id="PgsPetRollbackV1_Prepare" name="ROLLBACK_PREPARE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">ROLLBACK_PREPARE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="PgsPetRollbackV1_Confirm" name="Подтвердить текущий план отката" />
    <bpmn:serviceTask id="PgsPetRollbackV1_Execute" name="ROLLBACK_EXECUTE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">ROLLBACK_EXECUTE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PgsPetRollbackV1_Finalize" name="ROLLBACK_FINALIZE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">ROLLBACK_FINALIZE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PgsPetRollbackV1_End" name="Процесс проверки завершён" />
    <bpmn:sequenceFlow id="PgsPetRollbackV1_flow_Start" sourceRef="PgsPetRollbackV1_Start" targetRef="PgsPetRollbackV1_Setup" />
    <bpmn:sequenceFlow id="PgsPetRollbackV1_flow_Setup" sourceRef="PgsPetRollbackV1_Setup" targetRef="PgsPetRollbackV1_Prepare" />
    <bpmn:sequenceFlow id="PgsPetRollbackV1_flow_Prepare" sourceRef="PgsPetRollbackV1_Prepare" targetRef="PgsPetRollbackV1_Confirm" />
    <bpmn:sequenceFlow id="PgsPetRollbackV1_flow_Confirm" sourceRef="PgsPetRollbackV1_Confirm" targetRef="PgsPetRollbackV1_Execute" />
    <bpmn:sequenceFlow id="PgsPetRollbackV1_flow_Execute" sourceRef="PgsPetRollbackV1_Execute" targetRef="PgsPetRollbackV1_Finalize" />
    <bpmn:sequenceFlow id="PgsPetRollbackV1_flow_Finalize" sourceRef="PgsPetRollbackV1_Finalize" targetRef="PgsPetRollbackV1_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="PgsPetImportV1_diagram">
    <bpmndi:BPMNPlane id="PgsPetImportV1_plane" bpmnElement="PgsPetImportV1">
      <bpmndi:BPMNShape id="PgsPetImportV1_Start_shape" bpmnElement="PgsPetImportV1_Start">
        <dc:Bounds x="80" y="187.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsPetImportV1_Setup_shape" bpmnElement="PgsPetImportV1_Setup">
        <dc:Bounds x="290" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsPetImportV1_Parse_shape" bpmnElement="PgsPetImportV1_Parse">
        <dc:Bounds x="500" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsPetImportV1_Confirm_shape" bpmnElement="PgsPetImportV1_Confirm">
        <dc:Bounds x="710" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsPetImportV1_Apply_shape" bpmnElement="PgsPetImportV1_Apply">
        <dc:Bounds x="920" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsPetImportV1_Inspect_shape" bpmnElement="PgsPetImportV1_Inspect">
        <dc:Bounds x="1130" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsPetImportV1_Decision_shape" bpmnElement="PgsPetImportV1_Decision">
        <dc:Bounds x="1340" y="180.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsPetImportV1_Finalize_shape" bpmnElement="PgsPetImportV1_Finalize">
        <dc:Bounds x="1550" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsPetImportV1_End_shape" bpmnElement="PgsPetImportV1_End">
        <dc:Bounds x="1760" y="187.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="PgsPetImportV1_flow_Start_edge" bpmnElement="PgsPetImportV1_flow_Start">
        <di:waypoint x="116" y="205.0" />
        <di:waypoint x="290" y="205.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PgsPetImportV1_flow_Setup_edge" bpmnElement="PgsPetImportV1_flow_Setup">
        <di:waypoint x="450" y="205.0" />
        <di:waypoint x="500" y="205.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PgsPetImportV1_flow_Parse_edge" bpmnElement="PgsPetImportV1_flow_Parse">
        <di:waypoint x="660" y="205.0" />
        <di:waypoint x="710" y="205.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PgsPetImportV1_flow_Confirm_edge" bpmnElement="PgsPetImportV1_flow_Confirm">
        <di:waypoint x="870" y="205.0" />
