      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PgsPetValidationV1_flow_Parse_edge" bpmnElement="PgsPetValidationV1_flow_Parse">
        <di:waypoint x="660" y="205.0" />
        <di:waypoint x="710" y="205.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
