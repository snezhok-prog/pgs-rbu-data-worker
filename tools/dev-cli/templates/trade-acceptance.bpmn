      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PgsTradeImportV1_flow_Finalize_edge" bpmnElement="PgsTradeImportV1_flow_Finalize">
        <di:waypoint x="1710" y="205.0" />
        <di:waypoint x="1760" y="205.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PgsTradeImportV1_repeat_edge" bpmnElement="PgsTradeImportV1_repeat">
        <di:waypoint x="1365.0" y="230.0" />
        <di:waypoint x="1365.0" y="320" />
        <di:waypoint x="1000.0" y="320" />
        <di:waypoint x="1000.0" y="250.0" />
      </bpmndi:BPMNEdge>
