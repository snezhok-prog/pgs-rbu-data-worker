      <bpmndi:BPMNShape id="PgsTradeImportV1_Finalize_shape" bpmnElement="PgsTradeImportV1_Finalize">
        <dc:Bounds x="1550" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsTradeImportV1_End_shape" bpmnElement="PgsTradeImportV1_End">
        <dc:Bounds x="1760" y="187.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="PgsTradeImportV1_flow_Start_edge" bpmnElement="PgsTradeImportV1_flow_Start">
        <di:waypoint x="116" y="205.0" />
        <di:waypoint x="290" y="205.0" />
      </bpmndi:BPMNEdge>
