      <bpmndi:BPMNShape id="PgsTradeImportV1_Confirm_shape" bpmnElement="PgsTradeImportV1_Confirm">
        <dc:Bounds x="710" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsTradeImportV1_Apply_shape" bpmnElement="PgsTradeImportV1_Apply">
        <dc:Bounds x="920" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsTradeImportV1_Inspect_shape" bpmnElement="PgsTradeImportV1_Inspect">
        <dc:Bounds x="1130" y="160.0" width="160" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsTradeImportV1_Decision_shape" bpmnElement="PgsTradeImportV1_Decision">
        <dc:Bounds x="1340" y="180.0" width="50" height="50" />
