<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="ru.evolenta.pgs.trade.acceptance">
  <bpmn:process id="PgsTradeImportV1" name="Торговля — Импорт — DEV" isExecutable="true" camunda:historyTimeToLive="7">
    <bpmn:startEvent id="PgsTradeImportV1_Start" name="Начало" />
    <bpmn:userTask id="PgsTradeImportV1_Setup" name="Подготовить собственное дело и файл" />
    <bpmn:serviceTask id="PgsTradeImportV1_Parse" name="PARSE_VALIDATE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">PARSE_VALIDATE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="PgsTradeImportV1_Confirm" name="Проверить результат и подтвердить отпечаток файла" />
    <bpmn:serviceTask id="PgsTradeImportV1_Apply" name="IMPORT_APPLY" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">IMPORT_APPLY</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="PgsTradeImportV1_Inspect" name="Сверить пакет записей в реестрах" />
    <bpmn:exclusiveGateway id="PgsTradeImportV1_Decision" name="Есть следующий пакет или повтор?" default="PgsTradeImportV1_finish" />
    <bpmn:serviceTask id="PgsTradeImportV1_Finalize" name="IMPORT_FINALIZE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">IMPORT_FINALIZE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PgsTradeImportV1_End" name="Процесс проверки завершён" />
    <bpmn:sequenceFlow id="PgsTradeImportV1_flow_Start" sourceRef="PgsTradeImportV1_Start" targetRef="PgsTradeImportV1_Setup" />
    <bpmn:sequenceFlow id="PgsTradeImportV1_flow_Setup" sourceRef="PgsTradeImportV1_Setup" targetRef="PgsTradeImportV1_Parse" />
    <bpmn:sequenceFlow id="PgsTradeImportV1_flow_Parse" sourceRef="PgsTradeImportV1_Parse" targetRef="PgsTradeImportV1_Confirm" />
    <bpmn:sequenceFlow id="PgsTradeImportV1_flow_Confirm" sourceRef="PgsTradeImportV1_Confirm" targetRef="PgsTradeImportV1_Apply" />
    <bpmn:sequenceFlow id="PgsTradeImportV1_flow_Apply" sourceRef="PgsTradeImportV1_Apply" targetRef="PgsTradeImportV1_Inspect" />
    <bpmn:sequenceFlow id="PgsTradeImportV1_flow_Inspect" sourceRef="PgsTradeImportV1_Inspect" targetRef="PgsTradeImportV1_Decision" />
    <bpmn:sequenceFlow id="PgsTradeImportV1_finish" sourceRef="PgsTradeImportV1_Decision" targetRef="PgsTradeImportV1_Finalize" />
    <bpmn:sequenceFlow id="PgsTradeImportV1_flow_Finalize" sourceRef="PgsTradeImportV1_Finalize" targetRef="PgsTradeImportV1_End" />
    <bpmn:sequenceFlow id="PgsTradeImportV1_repeat" sourceRef="PgsTradeImportV1_Decision" targetRef="PgsTradeImportV1_Apply">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rbuApplyHasMoreBatches || rbuRepeat}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="PgsTradeValidationV1" name="Торговля — Валидация — DEV" isExecutable="true" camunda:historyTimeToLive="7">
    <bpmn:startEvent id="PgsTradeValidationV1_Start" name="Начало" />
    <bpmn:userTask id="PgsTradeValidationV1_Setup" name="Подготовить собственное дело и файл" />
    <bpmn:serviceTask id="PgsTradeValidationV1_Parse" name="PARSE_VALIDATE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">PARSE_VALIDATE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PgsTradeValidationV1_End" name="Процесс проверки завершён" />
    <bpmn:sequenceFlow id="PgsTradeValidationV1_flow_Start" sourceRef="PgsTradeValidationV1_Start" targetRef="PgsTradeValidationV1_Setup" />
    <bpmn:sequenceFlow id="PgsTradeValidationV1_flow_Setup" sourceRef="PgsTradeValidationV1_Setup" targetRef="PgsTradeValidationV1_Parse" />
    <bpmn:sequenceFlow id="PgsTradeValidationV1_flow_Parse" sourceRef="PgsTradeValidationV1_Parse" targetRef="PgsTradeValidationV1_End" />
  </bpmn:process>
  <bpmn:process id="PgsTradeRollbackV1" name="Торговля — Откат — DEV" isExecutable="true" camunda:historyTimeToLive="7">
    <bpmn:startEvent id="PgsTradeRollbackV1_Start" name="Начало" />
    <bpmn:userTask id="PgsTradeRollbackV1_Setup" name="Подготовить собственное дело и файл" />
    <bpmn:serviceTask id="PgsTradeRollbackV1_Prepare" name="ROLLBACK_PREPARE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">ROLLBACK_PREPARE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="PgsTradeRollbackV1_Confirm" name="Подтвердить текущий план отката" />
    <bpmn:serviceTask id="PgsTradeRollbackV1_Execute" name="ROLLBACK_EXECUTE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">ROLLBACK_EXECUTE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PgsTradeRollbackV1_Finalize" name="ROLLBACK_FINALIZE" camunda:type="external" camunda:topic="pgs-data-processing-v1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="rbuOperation">ROLLBACK_FINALIZE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PgsTradeRollbackV1_End" name="Процесс проверки завершён" />
    <bpmn:sequenceFlow id="PgsTradeRollbackV1_flow_Start" sourceRef="PgsTradeRollbackV1_Start" targetRef="PgsTradeRollbackV1_Setup" />
    <bpmn:sequenceFlow id="PgsTradeRollbackV1_flow_Setup" sourceRef="PgsTradeRollbackV1_Setup" targetRef="PgsTradeRollbackV1_Prepare" />
    <bpmn:sequenceFlow id="PgsTradeRollbackV1_flow_Prepare" sourceRef="PgsTradeRollbackV1_Prepare" targetRef="PgsTradeRollbackV1_Confirm" />
    <bpmn:sequenceFlow id="PgsTradeRollbackV1_flow_Confirm" sourceRef="PgsTradeRollbackV1_Confirm" targetRef="PgsTradeRollbackV1_Execute" />
    <bpmn:sequenceFlow id="PgsTradeRollbackV1_flow_Execute" sourceRef="PgsTradeRollbackV1_Execute" targetRef="PgsTradeRollbackV1_Finalize" />
    <bpmn:sequenceFlow id="PgsTradeRollbackV1_flow_Finalize" sourceRef="PgsTradeRollbackV1_Finalize" targetRef="PgsTradeRollbackV1_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="PgsTradeImportV1_diagram">
    <bpmndi:BPMNPlane id="PgsTradeImportV1_plane" bpmnElement="PgsTradeImportV1">
      <bpmndi:BPMNShape id="PgsTradeImportV1_Start_shape" bpmnElement="PgsTradeImportV1_Start">
        <dc:Bounds x="80" y="187.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PgsTradeImportV1_Setup_shape" bpmnElement="PgsTradeImportV1_Setup">
